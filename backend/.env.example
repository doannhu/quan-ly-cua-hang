# Backend config when running without Docker (copy to backend/.env)
PORT=4000
# Only listen locally; nginx forwards /api and /uploads here
HOST=127.0.0.1
DB_DRIVER=sqlite
SQLITE_PATH=/var/lib/quan-ly-cua-hang/store.db
UPLOAD_DIR=/var/lib/quan-ly-cua-hang/uploads
ADMIN_PASSWORD=change-me-admin
JWT_SECRET=change-me-to-a-long-random-string
# Optional read-only key for AI agents (header X-API-Key)
AI_API_KEY=
TZ=Asia/Ho_Chi_Minh
